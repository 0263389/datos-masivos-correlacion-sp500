# Copia este archivo a `.env` y rellena los valores.
# El archivo `.env` esta en .gitignore y NUNCA debe subirse al repositorio.
#
#   cp .env.example .env

# Llave gratuita de FRED (Federal Reserve Bank of St. Louis)
# Registro: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# SEC EDGAR exige identificarse con un correo en el User-Agent.
# Formato: "Nombre Apellido correo@dominio.com"
SEC_USER_AGENT=
